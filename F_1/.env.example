# Frontend Environment Variables
# Copy this to .env and fill in your values

# API Base URL — uses Vite proxy in dev, direct URL in production
VITE_API_BASE_URL=/api

# Direct backend URL for file uploads (bypasses proxy for multipart/form-data)
# In development: http://localhost:5000/api
# In production: https://your-backend.onrender.com/api
VITE_API_DIRECT_URL=http://localhost:5000/api

# Socket URL for real-time chat and updates (Optional if using VITE_API_DIRECT_URL)
# In development: http://localhost:5000
# In production: https://your-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000