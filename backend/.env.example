# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get your free cluster at: https://www.mongodb.com/atlas/database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=YourApp

# JWT Authentication
# Generate a random 64-char secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# CORS - update with your frontend deployment URL(s)
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Email Service (Optional - for order notifications & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourdomain.com

# ========== DIGITALOCEAN SPACES (Image Storage) ==========
# Get these from: https://cloud.digitalocean.com/settings/api/tokens
DIGITALOCEAN_SPACES_KEY=your_access_key_here
DIGITALOCEAN_SPACES_SECRET=your_secret_key_here
DIGITALOCEAN_SPACES_NAME=marketplace-assets
DIGITALOCEAN_SPACES_REGION=nyc3
DIGITALOCEAN_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DIGITALOCEAN_SPACES_CDN_URL=https://marketplace-assets.nyc3.cdn.digitaloceanspaces.com

# File Upload (Local Storage fallback)
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Payment Gateway (Optional - for future integration)
STRIPE_SECRET_KEY=sk_test_your_key
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
